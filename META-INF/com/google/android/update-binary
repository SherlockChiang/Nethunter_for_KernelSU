#!/sbin/sh

# KernelSU Manager uses the root-level customize.sh directly. This compatibility
# entry only rejects unsupported recovery installation.
OUTFD=$2
ui_print() {
    printf 'ui_print %s\nui_print\n' "$1" > "/proc/self/fd/$OUTFD"
}

ui_print " "
ui_print "********** Recovery Flash Detected **********"
ui_print "Install this module with KernelSU Manager."
ui_print "******* NetHunter Installation failed *******"
exit 1
